<% layout('layouts/boilerplate') %>

<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3>Listing Details :</h3>
    </div>
    
    <div class="card col-6 offset-2 show-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
            <p class="card-text">
                <b><%= listing.title %></b> <br>
                <%= listing.description %> <br>
                &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> <br>
                <%= listing.location %> <br>
                <%= listing.country %>
            </p>
        </div>
    </div>

    <div class="col-8 offset-2 d-flex mb-4">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-0 edit-btn">Edit</a>
        
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="ms-3">
            <button class="btn btn-dark">Delete</button>
        </form>
    </div>
</div>